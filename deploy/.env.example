# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
ALLOWED_HOSTS=travelmarketplace.com,www.travelmarketplace.com

# Database Configuration
DB_NAME=travel_marketplace
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgresql://postgres:your-database-password@db:5432/travel_marketplace

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@travelmarketplace.com

# PayPal Configuration
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# Amadeus API Configuration
AMADEUS_API_KEY=your-amadeus-api-key
AMADEUS_API_SECRET=your-amadeus-api-secret
AMADEUS_ENVIRONMENT=production

# CORS Settings
CORS_ALLOWED_ORIGINS=https://travelmarketplace.com,https://www.travelmarketplace.com

# File Storage
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles

# Logging
LOG_FILE=/var/log/django/travel_marketplace.log
ERROR_LOG_FILE=/var/log/django/travel_marketplace_error.log
DJANGO_LOG_LEVEL=INFO

# Monitoring
SENTRY_DSN=your-sentry-dsn-here

# Backup Settings
BACKUP_ENABLED=True
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_S3_ACCESS_KEY=your-s3-access-key
BACKUP_S3_SECRET_KEY=your-s3-secret-key
BACKUP_S3_REGION=us-east-1

# SSL Configuration
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Domain Configuration
DOMAIN=travelmarketplace.com
SITE_URL=https://travelmarketplace.com

# Social Login (Optional)
GOOGLE_OAUTH2_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH2_CLIENT_SECRET=your-google-client-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Analytics
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX

# Feature Flags
FEATURE_SOCIAL_LOGIN=False
FEATURE_REAL_TIME_NOTIFICATIONS=True
FEATURE_ADVANCED_SEARCH=True
FEATURE_MULTI_LANGUAGE=False
FEATURE_MOBILE_APP=False